{
  "name": "forge-sync-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.js",
    "test": "node --test site/test/*.test.js && cargo test",
    "test:claim:demo-cli": "cargo test --test demo_command claim_demo_completed_mirror_is_isolated_and_inspectable",
    "test:claim:demo-browser": "node --test --test-name-pattern=@claim:demo-browser-isolation site/test/browser.test.js",
    "test:claim:configuration": "node --test --test-name-pattern=@claim:configuration-has-no-token-field site/test/browser.test.js",
    "test:claim:offline": "node --test --test-name-pattern=@claim:offline-demo-after-first-visit site/test/browser.test.js",
    "test:claim:license": "node --test --test-name-pattern=@claim:mit-license site/test/claims-static.test.js",
    "test:claim:privacy": "node --test --test-name-pattern=@claim:website-no-tracking site/test/browser.test.js",
    "test:claim:targets": "cargo test --test target_adapters claim_supported_target_adapters_use_their_real_api_contracts",
    "test:claim:git-refs": "cargo test --test git_mirror mirrors_branches_and_tags_between_real_local_repositories",
    "test:claim:dry-run": "cargo test --test dry_run_regression dry_run_then_real_run_creates_every_reported_target_object_without_durable_dry_state",
    "test:claim:doctor": "cargo test --test doctor_read_only claim_doctor_checks_both_identities_with_gets_and_writes_nothing",
    "test:claim:configured-state-archive": "cargo test --test production_claims claim_configured_run_writes_selected_state_and_archive_paths",
    "test:claim:continuous-passes": "cargo test --test production_claims claim_daemon_makes_a_later_configured_pass",
    "test:claim:records-metadata": "cargo test --test production_claims claim_configured_run_records_discovery_refs_labels_milestones_and_issues",
    "test:claim:pull-request-history": "cargo test --test production_claims claim_configured_run_renders_every_pull_request_history_field",
    "test:claim:copied-attribution": "cargo test --test production_claims claim_configured_run_copies_author_time_and_github_links",
    "test:claim:optional-archive": "cargo test --test production_claims claim_configured_run_optionally_commits_the_json_archive",
    "test:claim:minimum-rust": "node --test --test-name-pattern=@claim:minimum-rust-build site/test/toolchain.test.js",
    "test:claim:demo-recording": "node --test --test-name-pattern=@claim:demo-recording-current-output site/test/demo-recording.test.js",
    "test:claim:json-output": "cargo test --test production_claims claim_status_and_sync_emit_json_documents",
    "test:claim:record-history": "cargo test --test production_claims claim_configured_run_persists_record_links_and_dated_history",
    "test:claim:scale": "cargo test --release --test scale_benchmark claim_organization_scale_initial_and_incremental_times -- --ignored --nocapture",
    "test:claims": "node scripts/run-claims.mjs",
    "record:demo": "node scripts/generate-demo-recording.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "build": "npm run build:site",
    "build:site": "vite build --config site/vite.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/ibm-plex-sans": "5.2.8",
    "playwright": "1.58.2",
    "vite": "7.3.6"
  }
}
